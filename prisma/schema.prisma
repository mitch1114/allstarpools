generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  playerCode   String   @unique
  name         String
  email        String   @default("")
  password     String
  isAdmin      Boolean  @default(false)
  hasPaid      Boolean  @default(false)
  referral     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  picks          Pick[]
  passwordResets PasswordReset[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Season {
  id        String   @id @default(cuid())
  year      Int      @unique
  isActive  Boolean  @default(true)
  weeks     Week[]
  games     Game[]
}

model Week {
  id        String   @id @default(cuid())
  number    Int
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  label     String   // e.g. "Week 1", "Bowl Week"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  games        Game[]
  picks        Pick[]
  weeklyPrizes WeeklyPrize[]

  @@unique([seasonId, number])
}

model Game {
  id            String   @id @default(cuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id])
  weekId        String
  week          Week     @relation(fields: [weekId], references: [id])
  league        String   // "NFL" or "NCAAF"
  awayTeam      String
  homeTeam      String
  spread        Float    @default(0) // negative = home favored, positive = away favored (standard: home team spread)
  gameTime      DateTime
  awayScore     Int?
  homeScore     Int?
  isFinal       Boolean  @default(false)
  isMondayNight Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  picks         Pick[]
}

model Pick {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekId    String
  week      Week     @relation(fields: [weekId], references: [id])
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  selection String   // "home" or "away"
  isHotPick Boolean  @default(false)
  tiebreaker Int?    // Monday Night total score guess (only on MNF picks)
  points    Int?     // calculated after game is final
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
}

model WeeklyPrize {
  id        String   @id @default(cuid())
  weekId    String
  week      Week     @relation(fields: [weekId], references: [id])
  userId    String
  amount    Float    @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([weekId, userId])
}
